cc_library_shared {
    name: "libinih",
    srcs: ["ini.c"],
    export_include_dirs: ["."],
    vendor_available: true,
}

cc_library_shared {
    name: "libinih-cpp",
    srcs: ["cpp/INIReader.cpp"],
    shared_libs: ["libinih"],
    export_include_dirs: [".", "cpp"],
    vendor_available: true,
}

cc_library_headers {
    name: "inih_headers",
    export_include_dirs: ["."],
    vendor_available: true,
}

cc_library_headers {
    name: "libinih-cpp_headers",
    export_include_dirs: [".", "cpp"],
    vendor_available: true,
}
